# Copy to .env for local development. NEVER commit a real .env file.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgres://tezkassa:tezkassa@localhost:5432/tezkassa

# --- Auth secrets (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=replace-with-a-64-char-hex-secret-for-access-tokens
JWT_REFRESH_SECRET=replace-with-a-different-64-char-hex-secret-for-refresh-tokens
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# --- Click Business merchant integration ---
# mock = safe for local dev/demo, never talks to real Click servers.
# live  = requires a real merchant secret configured per store; backend refuses to
#         boot in live mode with no store credentials configured.
CLICK_MODE=mock
# 32-byte hex key used to encrypt/decrypt each store's Click secret at rest.
# Generate with: openssl rand -hex 32
CLICK_CREDENTIALS_KEK=replace-with-a-64-char-hex-key
CLICK_API_BASE_URL=https://api.click.uz/v2/merchant

# --- Telegram notifications (optional) ---
TELEGRAM_ENABLED=false

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- File uploads (documents, product photos, attachments) ---
# For local dev, files are stored on local disk under UPLOAD_DIR.
# For production, point this at an S3-compatible bucket via UPLOAD_DRIVER=s3 and the
# AWS_* variables (see docs/production-deploy.md).
UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads
